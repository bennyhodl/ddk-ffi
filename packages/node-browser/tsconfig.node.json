{
  // Compiles the N-API entry (node/) to dist/node/.
  //
  // NodeNext keeps `import.meta.url` intact — the generated resolver needs it to
  // locate the platform package — which makes this package ESM-only. A CJS build
  // would break resolveLibPath, so there is deliberately no dual build.
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist/node",
    "rootDir": "node",
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["node/**/*.ts"]
}
