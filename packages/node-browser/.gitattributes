# Auto detect text files and perform LF normalization
*        text=auto


*.ts    text eol=lf merge=union
*.tsx   text eol=lf merge=union
*.js    text eol=lf merge=union
*.json  text eol=lf merge=union

# Generated by uniffi-bindgen-react-native — never hand-edited, and large enough
# to skew the repo's language stats.
node/generated/*.ts       linguist-generated=true
browser/generated/*.ts       linguist-generated=true
browser/generated/*.js       linguist-generated=true
