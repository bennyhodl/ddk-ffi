{
  "name": "@bennyblader/ddk",
  "version": "1.0.0-rc6",
  "description": "dlcdevkit bindings for Node (N-API) and the browser (wasm), generated from ddk-ffi via uniffi",
  "type": "module",
  "main": "./dist/node/index.js",
  "types": "./dist/node/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/wasm/index.d.ts",
        "default": "./dist/wasm/index.js"
      },
      "node": {
        "types": "./dist/node/index.d.ts",
        "default": "./dist/node/index.js"
      },
      "default": {
        "types": "./dist/wasm/index.d.ts",
        "default": "./dist/wasm/index.js"
      }
    },
    "./wasm": {
      "types": "./dist/wasm/index.d.ts",
      "default": "./dist/wasm/index.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bennyhodl/ddk-ffi.git"
  },
  "license": "MIT",
  "keywords": [
    "uniffi",
    "rust",
    "rust-dlc",
    "ddk",
    "dlcdevkit",
    "wasm"
  ],
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">= 18"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "generate": "node scripts/build-release.mjs --local",
    "generate:debug": "node scripts/build-release.mjs --local --debug",
    "build": "node scripts/build-release.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:wasm:debug": "node scripts/build-wasm.mjs --debug",
    "format": "prettier . -w",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:wasm": "vitest run --config vitest.wasm.config.ts",
    "test:watch": "vitest watch",
    "prepublishOnly": "node scripts/verify-package.mjs",
    "build:node": "node scripts/build-release.mjs --local",
    "build:browser": "node scripts/build-wasm.mjs",
    "check": "pnpm typecheck && pnpm format:check",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.wasm.json --noEmit && pnpm --filter ddk-example build",
    "test:browser": "pnpm test:wasm",
    "test:browser:smoke": "pnpm --filter ddk-example-browser smoke",
    "example:node": "pnpm --filter ddk-example dev",
    "example:contract": "pnpm --filter ddk-example contract",
    "example:browser": "pnpm --filter ddk-example-browser dev"
  },
  "dependencies": {
    "@ubjs/core": "0.31.0-5",
    "@ubjs/node": "0.31.0-5",
    "@ubjs/wasm": "0.31.0-5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "trailingComma": "all",
    "singleQuote": true,
    "arrowParens": "always"
  },
  "workspaces": [
    "../../examples/node",
    "../../examples/browser",
    "../../tests/conformance"
  ],
  "packageManager": "pnpm@10.14.0"
}
