{
  "name": "@bennyblader/ddk-rn",
  "version": "1.0.0-rc6",
  "description": "dlcdevkit bindings for react-native",
  "source": "./src/index.tsx",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "react-native": "./src/index.tsx",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    }
  },
  "files": [
    "src",
    "cpp",
    "lib",
    "android/build.gradle",
    "android/CMakeLists.txt",
    "android/cpp-adapter.cpp",
    "android/gradle.properties",
    "android/proguard-rules.pro",
    "android/src/main/AndroidManifest.xml",
    "android/src/main/AndroidManifestNew.xml",
    "android/src/main/java",
    "android/src/main/jniLibs",
    "ios/DdkRn.h",
    "ios/DdkRn.mm",
    "ios/DdkRn.xcframework",
    "ubrn.config.yaml",
    "*.podspec",
    "react-native.config.js",
    "README.md",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.DS_Store"
  ],
  "scripts": {
    "example": "pnpm --filter ddk-rn-example",
    "test": "jest",
    "typecheck": "tsc",
    "lint": "eslint --no-eslintrc --config .eslintrc.cjs \"**/*.{js,ts,tsx}\" \"../../examples/react-native/**/*.{js,ts,tsx}\"",
    "clean": "del-cli android/build lib",
    "prepare": "bob build",
    "prepublishOnly": "node scripts/verify-package.js",
    "verify-package": "node scripts/verify-package.js",
    "uniffi:clean": "del-cli src/generated cpp/ddk_ffi.* ios/*.xcframework android/src/main/jniLibs",
    "example:ios": "pnpm --filter ddk-rn-example ios",
    "example:android": "pnpm --filter ddk-rn-example android",
    "example:pods": "cd ../../examples/react-native/ios && pod install",
    "build": "bob build",
    "build:ios": "just build-ios",
    "build:android": "just build-android",
    "generate": "just uniffi-jsi && just uniffi-turbo",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "format": "prettier --write .eslintrc.cjs src scripts *.js *.json *.yaml",
    "format:check": "prettier --check .eslintrc.cjs src scripts *.js *.json *.yaml",
    "test:ios": "just e2e-ios",
    "test:android": "just e2e-android"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bennyhodl/ddk-ffi.git"
  },
  "author": "benny b <ben@bitcoinbay.foundation> (https://github.com/bennyhodl)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bennyhodl/ddk-ffi/issues"
  },
  "homepage": "https://github.com/bennyhodl/ddk-ffi#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "codegenConfig": {
    "name": "RNDdkRnSpec",
    "type": "modules",
    "jsSrcsDir": "src/generated",
    "android": {
      "javaPackageName": "com.ddkrn"
    },
    "ios": {
      "modules": {
        "DdkRn": {
          "className": "DdkRn"
        }
      }
    }
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^17.0.2",
    "@react-native-community/cli": "19.0.0",
    "@react-native-community/cli-platform-android": "19.0.0",
    "@react-native-community/cli-platform-ios": "19.0.0",
    "@react-native/eslint-config": "^0.80.0",
    "@types/jest": "^29.5.5",
    "@types/react": "^19.1.0",
    "commitlint": "^17.0.2",
    "del-cli": "^5.1.0",
    "eslint": "^8.51.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "prettier": "^3.0.3",
    "react": "19.1.0",
    "react-native": "0.80.0",
    "react-native-builder-bob": "0.30.0",
    "turbo": "^1.10.7",
    "typescript": "^5.2.2"
  },
  "resolutions": {
    "@types/react": "^19.1.0"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "jest": {
    "testEnvironment": "node",
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/"
    ],
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/?(*.)+(spec|test).js"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json",
          "esm": true
        }
      ]
    ]
  },
  "dependencies": {
    "@babel/runtime": "^7.20.0",
    "@ubjs/core": "0.31.0-5",
    "uniffi-bindgen-react-native": "0.31.0-5"
  },
  "packageManager": "pnpm@10.14.0"
}
