{
  "$schema": "https://turbo.build/schema.json",
  "pipeline": {
    "build:android": {
      "env": ["ORG_GRADLE_PROJECT_newArchEnabled"],
      "inputs": [
        "package.json",
        "android",
        "!android/build",
        "src/**/*.ts",
        "src/**/*.tsx",
        "../../examples/react-native/package.json",
        "../../examples/react-native/android",
        "!../../examples/react-native/android/.gradle",
        "!../../examples/react-native/android/build",
        "!../../examples/react-native/android/app/build"
      ],
      "outputs": []
    },
    "build:ios": {
      "env": ["RCT_NEW_ARCH_ENABLED"],
      "inputs": [
        "package.json",
        "*.podspec",
        "ios",
        "src/**/*.ts",
        "src/**/*.tsx",
        "../../examples/react-native/package.json",
        "../../examples/react-native/ios",
        "!../../examples/react-native/ios/build",
        "!../../examples/react-native/ios/Pods"
      ],
      "outputs": []
    }
  }
}
