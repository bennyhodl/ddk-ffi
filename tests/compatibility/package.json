{
  "name": "@bennyblader/ddk-bal-compat",
  "version": "0.0.0",
  "private": true,
  "description": "Compatibility test suite: ddk / ddk-rn wire messages and contract lifecycle against bitcoin-abstraction-layer (BAL) + @node-dlc",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:messages": "vitest run __test__/messages.spec.ts __test__/vectors.spec.ts",
    "test:lifecycle": "vitest run __test__/lifecycle.spec.ts __test__/splice.spec.ts",
    "vectors": "tsx scripts/generate-vectors.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@atomicfinance/bitcoin-ddk-provider": "5.0.0",
    "@atomicfinance/bitcoin-js-wallet-provider": "5.0.0",
    "@atomicfinance/bitcoin-rpc-provider": "5.0.0",
    "@atomicfinance/client": "5.0.0",
    "@atomicfinance/types": "5.0.0",
    "@bennyblader/ddk": "workspace:*",
    "@node-dlc/bitcoin": "1.2.1",
    "@node-dlc/messaging": "1.2.1",
    "@noble/curves": "^1.6.0",
    "bal-ddk": "npm:@bennyblader/ddk@1.0.0-rc7",
    "bitcoin-network": "0.1.0",
    "bitcoinjs-lib": "6.1.7",
    "bs58check": "^2.1.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
